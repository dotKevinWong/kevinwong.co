    "react-dom": "19.3.1",
    "react-icons": "^5.7.0",
    "rss-parser": "^3.13.0",
    "sharp": "^0.35.5",
    "swr": "^2.5.1"
  },
  "devDependencies": {
    "@types/node": "24.19.0",
