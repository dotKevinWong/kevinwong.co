    "instagram:token": "node scripts/instagram-token.mjs",
    "instagram:sync": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/instagram-sync.mjs",
    "instagram:repair": "node scripts/instagram-repair-source-keys.mjs",
